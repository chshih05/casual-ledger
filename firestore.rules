rules_version = '2';

// 隨便記：Cloud Firestore 安全規則
// - 資料放在 users/{登入帳號 uid}/entities/ 底下，只有該帳號本人能讀寫（在雲端伺服器檢查，不是只在畫面上隱藏）。
// - 每週的雲端自動備份放在 users/{uid}/backups/ 底下，只能新增，不能修改或刪除。
// - 另外只允許清單中的 Gmail 使用這個專案，避免陌生人登入後使用你的免費額度。
//
// 使用方式：到 Firebase 主控台 →「Firestore Database」→「規則」，貼上這份內容，
// 把 your_gmail@gmail.com 換成你自己的 Gmail（全部小寫）後按「發布」。
// 真實 Email 只填在主控台；這個檔案若要上傳到公開的 GitHub，請保留範例文字。
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['your_gmail@gmail.com'];
    }

    // 只接受網頁同步程式寫出的格式；版本號必須逐次加一，避免舊資料直接覆蓋新資料。
    function validEntity() {
      let d = request.resource.data;
      return d.keys().hasOnly(['k', 'kind', 'rev', 'h', 'del', 'd', 't', 'dev', 'serverTs', 'v'])
        && d.kind in ['rec', 'cat', 'mer', 'pref']
        && d.k is string && d.k.size() <= 220
        && d.rev is int
        && (resource == null ? d.rev == 1 : d.rev == resource.data.rev + 1)
        && d.h is string && d.h.size() <= 32
        && d.del is bool
        && d.d is map && d.d.size() <= 12
        && d.t is int && d.t >= 0
        && d.dev is string && d.dev.size() <= 80
        && d.serverTs == request.time
        && d.v == 1;
    }

    match /users/{uid}/entities/{entityId} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && validEntity();
      // 刪除紀錄只做「標記刪除」並保留最後內容，雲端文件本身不允許刪除。
      allow delete: if false;
    }

    // 雲端自動備份的說明（每週一份，代號例如 2026-W44）。內容壓縮後分段存在底下的 parts，和說明一起寫入。
    function validBackup(backupId) {
      let d = request.resource.data;
      return backupId.matches('^[0-9]{4}-W[0-9]{2}$')
        && d.keys().hasOnly(['v', 'at', 't', 'records', 'size', 'parts', 'enc', 'dev', 'app'])
        && d.v == 1
        && d.at == request.time
        && d.t is int && d.t >= 0
        && d.records is int && d.records >= 0
        && d.size is int && d.size >= 0
        && d.parts is int && d.parts >= 1 && d.parts <= 10
        && d.enc in ['gzip', 'json']
        && d.dev is string && d.dev.size() <= 80
        && d.app is string && d.app.size() <= 40;
    }

    function validBackupPart(partId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['i', 'data'])
        && d.i is int && d.i >= 0 && d.i < 10
        && partId == string(d.i)
        && d.data is bytes && d.data.size() <= 900000;
    }

    // 備份只能新增：程式出錯或誤按，也不會蓋掉或刪掉以前的備份。
    match /users/{uid}/backups/{backupId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && validBackup(backupId);
      allow update, delete: if false;

      match /parts/{partId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && validBackupPart(partId);
        allow update, delete: if false;
      }
    }
  }
}
